    <string name="qobuz_quality_aac_320_desc">Lossy, smallest size. Good for mobile data.</string>
    <string name="qobuz_quality_cd">CD quality (FLAC 16-bit / 44.1 kHz)</string>
    <string name="qobuz_quality_cd_desc">Lossless. Recommended default.</string>
    <string name="qobuz_quality_hires">Hi-Res (FLAC up to 24-bit / 192 kHz)</string>
    <string name="qobuz_quality_hires_desc">Lossless at the highest bit depth and sample rate available.</string>
